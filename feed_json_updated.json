u7ec4\u7ec7\u5339\u914d\u4e0eASA\u6846\u67b6</h1>\n<p>2026-09-22 \u00b7 \u4eba\u4e8b\u6d4b\u8bc4\u4e0e\u9009\u62d4</p>\n<h2>\u4e00\u3001\u6280\u672f\u53d8\u5316\u600e\u6837\u5f71\u54cd\u9009\u4eba\u7528\u4eba</h2>\n<h3>1. AI \u63d0\u5347\u6548\u7387\uff0c\u4e5f\u6539\u53d8\u5bf9\u4eba\u7684\u8981\u6c42</h3>\n<p><strong>AI\u8bb2\u89e3</strong></p>\n<p>AI \u9762\u8bd5\u80fd\u6269\u5927\u7b5b\u9009\u8303\u56f4\u3001\u52a0\u5feb\u5206\u6790\uff0c\u4f46\u9009\u62d4\u662f\u5426\u6709\u6548\u4ecd\u53d6\u51b3\u4e8e\u8bc4\u4ef7\u4ec0\u4e48\u3001\u600e\u6837\u8bc4\u5206\u3002\u4f4e\u4ee3\u7801\u5de5\u5177\u964d\u4f4e\u4e86\u5f00\u53d1\u95e8\u69db\uff0c\u6d4b\u8bc4\u7406\u8bba\u548c\u8bc4\u5206\u6807\u51c6...</p>", "image": null, "date_modified": "2026-11-19T06:51:01+00:00", "date_published": "2026-11-19T06:51:01+00:00", "authors": [], "tags": null}, {"id": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-09-24/", "url": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-09-24/", "title": "\u7b2c5\u8282 \u6d4b\u91cf\u7406\u8bba\u3001\u4fe1\u5ea6\u4e0e\u6548\u5ea6", "content_html": "<h1>\u7b2c5\u8282\uff5c\u6d4b\u91cf\u7406\u8bba\u3001\u4fe1\u5ea6\u4e0e\u6548\u5ea6</h1>\n<p>2026-09-24 \u00b7 \u4eba\u4e8b\u6d4b\u8bc4\u4e0e\u9009\u62d4</p>\n<h2>\u4e00\u3001\u6d4b\u91cf\u5982\u4f55\u63a5\u8fd1\u8981\u4e86\u89e3\u7684\u7279\u5f81</h2>\n<h3>1. \u771f\u5206\u6570\u7406\u8bba\uff1a\u4e00\u6b21\u5f97\u5206\u5305\u542b\u8bef\u5dee</h3>\n<p><strong>AI\u8bb2\u89e3</strong></p>\n<p>\u7b14\u8bd5\u3001\u9762\u8bd5\u3001\u95ee\u5377\u548c\u65e0\u9886\u5bfc\u5c0f\u7ec4\u8ba8\u8bba\u90fd\u5728\u6d4b\u91cf\u67d0\u4e9b\u80fd\u529b\u6216\u7279\u8d28\u3002\u7ecf\u5178\u6d4b\u9a8c\u7406\u8bba\u628a\u89c2\u6d4b\u5206\u6570\u5199\u6210 $X=T+E$\uff0c\u5206\u522b\u8868\u793a\u89c2\u6d4b\u5206\u6570\u3001\u771f\u5206\u6570\u548c\u8bef\u5dee...</p>", "image": null, "date_modified": "2026-11-19T06:51:01+00:00", "date_published": "2026-11-19T06:51:01+00:00", "authors": [], "tags": null}, {"id": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-09-29/", "url": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-09-29/", "title": "\u7b2c6\u8282 \u6548\u5ea6\u68c0\u9a8c\u4e0e\u5de5\u4f5c\u5206\u6790", "content_html": "<h1>\u7b2c6\u8282\uff5c\u6548\u5ea6\u68c0\u9a8c\u4e0e\u5de5\u4f5c\u5206\u6790</h1>\n<p>2026-09-29 \u00b7 \u4eba\u4e8b\u6d4b\u8bc4\u4e0e\u9009\u62d4</p>\n<h2>\u4e00\u3001\u600e\u6837\u5224\u65ad\u6d4b\u8bc4\u5de5\u5177\u662f\u5426\u6709\u6548</h2>\n<h3>1. \u4fe1\u5ea6\u4e0e\u51e0\u79cd\u6548\u5ea6\u5206\u522b\u68c0\u67e5\u4ec0\u4e48</h3>\n<p><strong>AI\u8bb2\u89e3</strong></p>\n<p>\u4fe1\u5ea6\u68c0\u67e5\u6d4b\u91cf\u7ed3\u679c\u662f\u5426\u7a33\u5b9a\u3001\u4e00\u81f4\uff1a\u540c\u4e00\u6279\u4eba\u524d\u540e\u505a\u540c\u4e00\u5957\u9898\u3001\u505a\u96be\u5ea6\u76f8\u8fd1\u7684\u4e24\u5957\u9898\uff0c\u6216\u7531\u4e0d\u540c\u8003\u5b98\u8bc4\u5206\uff0c\u7ed3\u679c\u5e94\u6709\u8f83\u9ad8\u76f8\u5173\u3002\u4f4e\u76f8\u5173\u53ef\u80fd\u6765\u81ea\u9898\u76ee\u6b67\u4e49...</p>", "image": null, "date_modified": "2026-11-19T06:51:01+00:00", "date_published": "2026-11-19T06:51:01+00:00", "authors": [], "tags": null}, {"id": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-10-08/", "url": "https://note.elliotttzhang.cn/FINANCE/personnel-assessment/2026-10-08/", "title": "\u7b2c7\u8282 \u80dc\u4efb\u529b\u5efa\u6a21\u4e0e\u5173\u952e\u4e8b\u4ef6\u8bbf\u8c08", "content_html": "<h1>\u7b2c7\u8282\uff5c\u80dc\u4efb\u529b\u5efa\u6a21\u4e0e\u5173\u952e\u4e8b\u4ef6\u8bbf\u8c08</h1>\n<p>2026-10-08 \u00b7 \u4eba\u4e8b\u6d4b\u8bc4\u4e0e\u9009\u62d4</p>\n<h2>\u4e00\u3001\u9009\u4eba\u4f9d\u636e\u4e3a\u4ec0\u4e48\u9700\u8981\u53d8\u5316</h2>\n<h3>1. \u5de5\u4f5c\u5206\u6790\u9002\u7528\u7684\u6761\u4ef6\u4e0e\u6311\u6218</h3>\n<p><strong>AI\u8bb2\u89e3</strong></p>\n<p>\u5de5\u4f5c\u5206\u6790\u4ece\u5c97\u4f4d\u51fa\u53d1\uff0c\u8c03\u67e5\u5de5\u4f5c\u5185\u5bb9\u3001\u65f6\u95f4\u5360\u6bd4\u3